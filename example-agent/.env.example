# Example environment variables for OpenChat Agent
# Copy this file to .env and fill in your actual values

# Required: Your OpenChat identity (seed phrase or private key)
OPENCHAT_IDENTITY=your-seed-phrase-or-private-key-here

# Required: Your OpenChat user ID (Principal)
OPENCHAT_USER_ID=your-principal-id-here

# Optional: Your OpenChat username
OPENCHAT_USERNAME=your-username

# Optional: OpenChat API URL (defaults to mainnet)
OPENCHAT_API_URL=https://5v72r-4qaaa-aaaaf-aaapq-cai.ic0.app
